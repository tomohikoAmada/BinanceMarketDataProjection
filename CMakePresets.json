{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BMD_PROJECTION_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/debug/cmake",
      "toolchainFile": "${sourceDir}/build/debug/build/Debug/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BMD_PROJECTION_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/release/cmake",
      "toolchainFile": "${sourceDir}/build/release/build/Release/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BMD_PROJECTION_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asan/cmake",
      "toolchainFile": "${sourceDir}/build/asan/build/Debug/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "BMD_PROJECTION_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "ubsan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/ubsan/cmake",
      "toolchainFile": "${sourceDir}/build/ubsan/build/Debug/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "BMD_PROJECTION_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/tsan/cmake",
      "toolchainFile": "${sourceDir}/build/tsan/build/Debug/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "BMD_PROJECTION_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/coverage/cmake",
      "toolchainFile": "${sourceDir}/build/coverage/build/Debug/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "BMD_PROJECTION_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "benchmark",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/benchmark/cmake",
      "toolchainFile": "${sourceDir}/build/benchmark/build/Release/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "BMD_PROJECTION_BUILD_TESTS": "OFF",
        "BMD_PROJECTION_BUILD_BENCHMARKS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ubsan", "configurePreset": "ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "benchmark", "configurePreset": "benchmark" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "ubsan", "configurePreset": "ubsan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } }
  ]
}
