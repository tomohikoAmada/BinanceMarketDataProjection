# Canonical Quality toolchain contract (INFRA-TC-001).
#
# This file is the SINGLE SOURCE OF TRUTH for the canonical Quality acceptance
# environment. It is consumed by:
#   - .toolchain/Dockerfile   (container image build; exact package pins)
#   - scripts/quality-toolchain-check.sh (fail-closed identity validation)
#   - scripts/quality.sh      (canonical Quality entrypoint)
#   - .github/workflows/ci.yml (reporting the contract on CI)
#
# Format: KEY=VALUE, one per line; '#' starts a comment; no quoting.
# Version literals for acceptance-critical LLVM tools MUST NOT be duplicated
# in any other file. See docs/QUALITY_TOOLCHAIN.md for the upgrade procedure.

# Canonical environment identity.
CANONICAL_QUALITY_OS=ubuntu-24.04
CANONICAL_QUALITY_ARCH=x86_64
CANONICAL_QUALITY_BASE_IMAGE=ubuntu:24.04
# Immutable base image identity (amd64 manifest, resolved 2026-08-15 from the
# official Docker Hub repository ubuntu:24.04). The digest, not the mutable
# tag, is the identity.
CANONICAL_QUALITY_BASE_IMAGE_DIGEST=sha256:019e8eb29a85e74d64925745884f2ec79aa27e3feab36353d24656f4d6b89467

# Canonical LLVM tool identity: clang, clang++, clang-tidy, clang-format.
# Exact upstream version, fail-closed. Package pins are the exact Ubuntu noble
# archive versions that provide this identity.
LLVM_MAJOR=18
LLVM_MINOR=1
LLVM_PATCH=3
CLANG_PACKAGE_PIN=clang-18=1:18.1.3-1ubuntu1
CLANG_TIDY_PACKAGE_PIN=clang-tidy-18=1:18.1.3-1ubuntu1
CLANG_FORMAT_PACKAGE_PIN=clang-format-18=1:18.1.3-1ubuntu1

# Compiler support packages installed in the canonical image.
# g++-13 provides the libstdc++ headers used by the canonical clang build and
# mirrors the compiler mix of the hosted CI image (recorded, not asserted).
GXX_PACKAGE_PIN=g++-13=13.3.0-6ubuntu2~24.04.1

# Build driver packages. Installed with exact pins for image determinism and
# recorded by the toolchain check; acceptance fail-closed assertions are the
# LLVM tools plus the CMake floor from CMakePresets.json (cmakeMinimumRequired)
# and the Python floor below.
CMAKE_PACKAGE_PIN=cmake=3.28.3-1build7
NINJA_PACKAGE_PIN=ninja-build=1.11.1-2
MAKE_PACKAGE_PIN=make=4.3-4.1build2
PATCH_PACKAGE_PIN=patch=2.7.6-7build3
PYTHON_VENV_PACKAGE_PIN=python3-venv=3.12.3-0ubuntu2.1
GIT_PACKAGE_PIN=git=1:2.43.0-1ubuntu7.3
CA_CERTIFICATES_PACKAGE_PIN=ca-certificates=20260601~24.04.1

# Language and minimum-version contract floors.
CPP_STANDARD=20
# CMake floor mirrors CMakePresets.json "cmakeMinimumRequired" (3.24.0);
# the toolchain check reads that JSON file, not this key.
PYTHON_MINIMUM_VERSION=3.10.0

# Conan identity: authoritative pin lives in requirements-tools.txt
# (conan==2.31.2). The toolchain check derives the expected version from that
# file; this contract deliberately does not duplicate the literal.
